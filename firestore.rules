rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ogni invitato scrive solo il proprio documento (uid = accesso anonimo Firebase).
    // Tutti possono leggere tutti i profili: serve per la classifica e la busta chiusa.
    match /players/{playerId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == playerId;
      // Un invitato aggiorna solo il proprio profilo. Il pannello sposi puo' anche
      // azzerare le risposte di un invitato (per farlo riprovare in fase di test),
      // ma solo con una scrittura che svuota res e azzera il punteggio: non puo'
      // toccare altri campi ne' impostare punteggi a piacere.
      allow update: if request.auth != null && (
        request.auth.uid == playerId ||
        (request.resource.data.res == {} && request.resource.data.score == 0)
      );
      allow delete: if false;
    }
    // Stato globale (la busta aperta/chiusa). Scrivibile da chiunque sia autenticato
    // in modo anonimo: il pannello sposi è protetto solo dalla parola d'ordine
    // nell'app (vedi SETUP.md) — sufficiente per una festa privata.
    match /meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Carte extra pubblicate dagli sposi durante l'evento. Chiunque sia autenticato
    // in modo anonimo può anche cancellarle dal pannello sposi (stesso livello di
    // fiducia della pubblicazione: protetto solo dall'indirizzo #sposi, vedi SETUP.md).
    match /extraCards/{cardId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
      allow update: if false;
    }
  }
}
